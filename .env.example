APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SEED_DEMO=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parc_commune
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PDF header (mission orders, reports). Each value is the full printed line.
# Leave a value empty to hide that line. Run `php artisan config:clear` after a change.
# The commune line uses the name from the "Paramètres" page first, then PDF_COMMUNE_*.
PDF_ROYAUME_FR="ROYAUME DU MAROC"
PDF_ROYAUME_AR="المملكة المغربية"
PDF_MINISTERE_FR="MINISTERE DE L'INTERIEUR"
PDF_MINISTERE_AR="وزارة الداخلية"
PDF_WILAYA_FR="WILAYA GHARB CHRARDA BNI HSSEN"
PDF_WILAYA_AR="ولاية الغرب الشراردة بني احسن"
PDF_REGION_FR=
PDF_REGION_AR=
PDF_PROVINCE_FR="PROVINCE DE SIDI SLIMANE"
PDF_PROVINCE_AR="عمالة اقليم سيدي سليمان"
PDF_PACHALIK_FR="PACHALIK DE SIDI YAHIA DU GHARB"
PDF_PACHALIK_AR="باشاوية سيدي يحيى الغرب"
PDF_COMMUNE_FR="MUNICIPALITE DE SIDI YAHIA GHARB"
PDF_COMMUNE_AR="بلدية سيدي يحيى الغرب"
PDF_CITY_FR="Sidi Yahia du Gharb"
PDF_CITY_AR="سيدي يحيى الغرب"
PDF_CITY_SHORT_FR="S.Y.G."
# Optional logo, path relative to public/ (e.g. assets/images/logo.png)
PDF_LOGO=
